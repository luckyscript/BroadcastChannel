---
import { getEnv } from '../lib/env'
import { formatPostTime, getTagHref } from '../lib/post-ui'

const locale = getEnv(import.meta.env, 'LOCALE')
const timezone = getEnv(import.meta.env, 'TIMEZONE')

const { post } = Astro.props as {
  post: {
    date: string
    html?: string
    tags?: string[]
    title: string
  }
}
const timeago = await formatPostTime(post.date, timezone, locale)
const hasContent = Boolean(post.html?.length)
const hasTags = Boolean(post.tags?.length)
---

<article class="post-entry" style={{ 'view-transition-name': `legacy-post-${post.title}` }}>
  <div class="post-meta">
    <span class="timeline-dot" aria-hidden="true"></span>
    <p>
      <time datetime={post.date} title={timeago}>{timeago}</time>
    </p>
  </div>
  {hasContent && <div class="post-content content" set:html={post.html} />}
  {
    hasTags && (
      <p class="tags post-tags">
        <span class="tag-icon" aria-hidden="true" />
        {post.tags.map((tag) => (
          <a href={getTagHref(tag)} title={tag}>
            {tag}
          </a>
        ))}
      </p>
    )
  }
</article>
