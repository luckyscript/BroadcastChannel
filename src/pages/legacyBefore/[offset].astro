---
import BaseLayout from '../../layouts/BaseLayout.astro'
import LegacyItem from '../../components/legacyItem.astro'
import { legacyData } from '../../../legacy/data.js'
import { getChannelInfo } from '../../lib/telegram'
import type { SeoMeta } from '../../types'

const channel = await getChannelInfo()

const { SITE_URL } = Astro.locals

const { offset } = Astro.params
const currentOffset = Number(offset)
const nextOffset = currentOffset + 20
const pageSeo: SeoMeta = {
  noindex: true,
  title: 'Legacy',
}

export const prerender = false
---

<BaseLayout channel={channel} pageClass="feed" pageType="page" seo={pageSeo}>
  <h1 class="sr-only">Legacy</h1>
  <ol class="posts-feed" aria-label="Legacy posts">
    {legacyData.slice(currentOffset, nextOffset).map((post) => <li><LegacyItem post={post} /></li>)}
  </ol>

  {
    nextOffset < legacyData.length && (
      <nav class="pagination" aria-label="Pagination">
        <a href={`${SITE_URL}legacyBefore/${nextOffset}`} title="Older legacy posts" aria-label="Older legacy posts" class="older">
          <span aria-hidden="true">←</span>
        </a>
      </nav>
    )
  }
</BaseLayout>
